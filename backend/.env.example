# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Python interpreter used to run the static analyzer. For the real analyzer
# this must be one that has pefile installed
# (pip install -r ../malware_detection/requirements.txt).
PYTHON_PATH=python3

# Static analyzer script. The default is a mock that needs no Python
# packages and returns canned PE fields. For real analysis use the team's
# analyzer instead:
#   ANALYZER_SCRIPT_PATH=../malware_detection/analyze.py
ANALYZER_SCRIPT_PATH=./scripts/mock_analyze.py

# Where uploaded samples are stored before/after analysis.
UPLOAD_DIR=./uploads

# Database. Set DATABASE_URL to use the team's shared Azure PostgreSQL server
# (setup and connection string: docs/azure-database.md). Leave it empty to
# use a local SQLite file at DATABASE_PATH instead.
DATABASE_URL=
DATABASE_PATH=./data/sentinel.db
# TLS to PostgreSQL. Azure requires it; set false only for a Postgres on
# your own machine.
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
# Which backend owns a scan job (uploads are saved on this machine, so only
# this backend can scan them). Default: computer name + port. Set it only if
# two backends on one computer share a database.
# WORKER_ID=

# Guardrails the analyzer handoff called out as the backend team's
# responsibility before exposing a real upload service.
MAX_UPLOAD_BYTES=26214400
ANALYZER_TIMEOUT_MS=15000

# Job queue: how many scans run at once, and how long a `?wait=true` request
# is held open before it falls back to a 202 the client polls.
JOB_CONCURRENCY=2
WAIT_TIMEOUT_MS=30000

# Signature catalog. The JSON catalog is committed. The hash list is an
# optional bulk feed (one SHA-256 per line, # comments allowed) -- leave it
# unset unless you have downloaded one; do not commit the feed file.
SIGNATURE_CATALOG_PATH=./signatures/catalog.json
# SIGNATURE_HASHLIST_PATH=./signatures/feeds/hashes.txt

MAX_URL_LENGTH=2048

# Sandbox stage: the team's sandbox service (dynamic_telemetry/api.py).
# Leave empty to skip the sandbox and behavioral ML stages. Base URL only;
# the backend calls <SANDBOX_URL>/detonate. Detonations are sent one at a
# time because the sandbox has a single VM.
SANDBOX_URL=
SANDBOX_DETONATION_SECONDS=15
SANDBOX_TIMEOUT_MS=120000

# Behavioral ML stage, called over HTTP (see src/stages/httpStage.js) rather
# than spawned like the static analyzer -- the ML team's
# `predict.py --serve`. Runs only when SANDBOX_URL is set.
BEHAVIORAL_ML_URL=http://127.0.0.1:8000/
BEHAVIORAL_ML_TIMEOUT_MS=15000

# Accounts and sessions. A login lasts SESSION_TTL_HOURS. Set COOKIE_SECURE=true
# once the site is served over HTTPS (leave false for http://localhost).
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
MAX_FAILED_LOGINS=10

# The backend serves the dashboard pages from this folder at
# http://localhost:3000/ so pages and API share one origin. Set it to an
# empty value to turn that off.
WEBSITE_DIR=../website
# Extra origins allowed to call the API with the session cookie, when the
# pages are served some other way (VS Code Live Server uses port 5500).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
