# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Absolute path to the Python interpreter that has the malware_detection
# analyzer's dependencies installed (pefile, etc).
PYTHON_PATH=python3

# Absolute path to malware_detection/analyze.py once the malware-detection
# branch is merged in. Until then, point this at backend/scripts/mock_analyze.py
# for local development.
ANALYZER_SCRIPT_PATH=./scripts/mock_analyze.py

# Where uploaded samples are stored before/after analysis.
UPLOAD_DIR=./uploads

# SQLite file path (swap for a real Postgres connection string later if needed).
DATABASE_PATH=./data/sentinel.db

# Guardrails called out in DEMO_AND_HANDOFF.md as the backend team's
# responsibility before exposing a real upload service.
MAX_UPLOAD_BYTES=26214400
ANALYZER_TIMEOUT_MS=15000

# Job queue: how many scans run at once, and how long a `?wait=true` request
# is held open before it falls back to a 202 the client polls.
JOB_CONCURRENCY=2
WAIT_TIMEOUT_MS=30000

# Signature catalog. The JSON catalog is committed. The hash list is an
# optional bulk feed (one SHA-256 per line, # comments allowed) -- leave it
# unset unless you have downloaded one; do not commit the feed file.
SIGNATURE_CATALOG_PATH=./signatures/catalog.json
# SIGNATURE_HASHLIST_PATH=./signatures/feeds/hashes.txt

MAX_URL_LENGTH=2048

# Behavioral ML stage, called over HTTP (see src/stages/httpStage.js) rather
# than spawned like the static analyzer -- matches the ML team's
# `predict.py --serve` pattern. Not wired into a route yet; see README.
BEHAVIORAL_ML_URL=http://127.0.0.1:8000/
BEHAVIORAL_ML_TIMEOUT_MS=15000
